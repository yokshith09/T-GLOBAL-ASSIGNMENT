{
  "name": "gold-loan-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Gold-loan intake portal with a validated full-stack app and an AI loan-assist agent.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server",
    "eval": "npm run eval --workspace server",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "postinstall": "npm run prisma:generate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
