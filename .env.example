# ---- Server ----
# Supabase Postgres. Use the "Connection string" from
# Supabase > Project Settings > Database. Prefer the pooled (pgBouncer, port 6543)
# URL for the app and the direct (port 5432) URL for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used by `prisma migrate` (set in server/.env or inline).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# API
PORT=4000
NODE_ENV=development

# Business constants (24K gold rate in paise per gram; 700000 = Rs 7,000/g)
RATE_24K_PAISE_PER_GRAM=700000

# ---- LLM (server-side only; never expose to the browser) ----
# Primary: Google Gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback: Groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Client ----
# Base URL the frontend uses to reach the API
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Passcode for the /admin view (cosmetic gate — set your own)
VITE_ADMIN_PASSCODE=aurum-admin
