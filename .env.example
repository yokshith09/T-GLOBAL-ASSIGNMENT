# ---- Server ----
# Supabase Postgres, Session pooler (Supabase > Connect > ORMs). Use this same
# connection string — port 5432 — for BOTH vars below; this is the one we've
# actually used successfully. The direct host (db.<ref>.supabase.co) is
# IPv6-only, so most networks can't reach it at all.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# API
PORT=4000
NODE_ENV=development

# Business constants (24K gold rate in paise per gram; 700000 = Rs 7,000/g)
RATE_24K_PAISE_PER_GRAM=700000

# ---- LLM (server-side only; never expose to the browser) ----
# Primary: Google Gemini (verified live 2026-10; see README for how to re-check)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Fallback: Groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ---- Client ----
# Base URL the frontend uses to reach the API
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Passcode for the /admin view (cosmetic gate — set your own)
VITE_ADMIN_PASSCODE=aurum-admin
